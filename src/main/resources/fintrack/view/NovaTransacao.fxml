<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fintrack.controller.NovaTransacaoController">
   <stylesheets>
    <URL value="@style.css" />
   </stylesheets>
   <top> 
      <Label alignment="CENTER" prefHeight="50.0" prefWidth="800.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cadastro de Transação" BorderPane.alignment="CENTER" />
   </top>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="800.0" spacing="10.0" style="-fx-padding: 10px;" BorderPane.alignment="CENTER">
         <children>
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="40.0" prefWidth="120.0" text="Cancelar" />
            <Button fx:id="btnSalvar" alignment="CENTER" mnemonicParsing="false" onAction="#salvar" prefHeight="40.0" prefWidth="120.0" text="Salvar" />
         </children>
      </HBox>
   </bottom>
   <center>
      <Pane prefHeight="390.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="45.0" layoutY="20.0" text="Qual o tipo da transação?" />
            <RadioButton layoutX="53.0" layoutY="45.0" mnemonicParsing="false" text="Receita">
               <toggleGroup>
                  <ToggleGroup fx:id="tipoTransacao" />
               </toggleGroup>
            </RadioButton>
            <RadioButton layoutX="53.0" layoutY="71.0" mnemonicParsing="false" text="Despesa" toggleGroup="$tipoTransacao" />
            <RadioButton layoutX="165.0" layoutY="45.0" mnemonicParsing="false" text="Receita mensal" toggleGroup="$tipoTransacao" />
            <RadioButton layoutX="165.0" layoutY="71.0" mnemonicParsing="false" text="Despesa mensal" toggleGroup="$tipoTransacao" />
            
            <Label layoutX="45.0" layoutY="115.0" text="Digite o valor:" />
            <TextField fx:id="campoValor" layoutX="45.0" layoutY="136.0" prefWidth="250.0" />
            
            <Label layoutX="45.0" layoutY="180.0" text="Descrição:" />
            <TextField fx:id="campoDescricao" layoutX="45.0" layoutY="201.0" prefWidth="350.0" />
            
            <Label layoutX="45.0" layoutY="245.0" text="Informe a data:" />
            <DatePicker fx:id="campoData" layoutX="45.0" layoutY="266.0" prefHeight="26.0" prefWidth="200.0" />
         </children>
      </Pane>
   </center>
</BorderPane>