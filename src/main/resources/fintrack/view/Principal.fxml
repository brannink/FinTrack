<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fintrack.controller.PrincipalController">
   <stylesheets>
    <URL value="@style.css" />
   </stylesheets>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="800.0" spacing="10.0" style="-fx-padding: 10px;" BorderPane.alignment="CENTER">
         <children>
            <Pane style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRemoverTransacao" mnemonicParsing="false" onAction="#removerTransacao" prefHeight="40.0" prefWidth="120.0" text="Remover" />
            <Button fx:id="btnAdicionarTransacao" alignment="CENTER" mnemonicParsing="false" onAction="#adicionarTransacao" prefHeight="40.0" prefWidth="120.0" text="Adicionar" />
         </children>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="tabelaTransacao" prefHeight="400.0" prefWidth="800.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="campoId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="campoDescricao" prefWidth="250.0" text="Descrição" />
            <TableColumn fx:id="campoValor" prefWidth="150.0" text="Valor" />
            <TableColumn fx:id="campoTipo" prefWidth="150.0" text="Tipo" />
            <TableColumn fx:id="campoData" prefWidth="150.0" text="Data" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="800.0" style="-fx-padding: 0 0 0 15px;" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label text="Saldo: R$ " style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="labelSaldo" text="0.00" />
         </children>
      </HBox>
   </top>
</BorderPane>
